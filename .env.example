# StudyBolt needs no environment variables: every student enters their own Gemini API key in the app,
# and it stays in their browser. Never put a Gemini key here.

# Optional: lets the Resources tab search YouTube for real videos (free, 10,000 units/day;
# each search costs 100). Create a key in Google Cloud with the YouTube Data API v3 enabled.
# It's used only on the server. Gemini API keys from AI Studio don't work here.
# YOUTUBE_API_KEY=

# Optional model overrides. Each is tried first, then the app falls back through other Gemini models.
# These are built into the page, so only put model names here.
# NEXT_PUBLIC_GEMINI_MODEL=gemini-3.8-flash            # notes, flashcards, quizzes, chat
# NEXT_PUBLIC_GEMINI_FAST_MODEL=gemini-3.5-flash-lite  # titles and transcripts
# NEXT_PUBLIC_GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
